# Google Maps 사용 시 아래 키를 채우고 .env.local 로 복사하세요.
# 비워두면 자동으로 자체 SVG 기반 대체 지도(mock map)가 사용됩니다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 온라인 공유(Cloudflare Worker + D1) 백엔드 주소. 비워두면 /trips의 "온라인으로
# 공유하기" 카드가 비활성 상태로 표시되고, 앱은 지금까지처럼 localStorage 기반
# 로컬 모드로만 동작합니다. 배포 방법은 worker/README-worker.md 참고.
NEXT_PUBLIC_API_BASE_URL=
